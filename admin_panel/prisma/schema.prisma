generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
}

// =============================================
// 1. CONTENT & NEWS
// =============================================

model Content {
  id    Int          @id @default(autoincrement())
  type  ContentType?
  slug  String?      @unique

  titleUk String?
  titleEn String?
  textUk  String?  @db.Text
  textEn  String?  @db.Text

  photoGallery String[] @default([])
  videoUrl     String?

  publicationDate DateTime? @default(now())
  attributes      Json?

  createdAt DateTime? @default(now())
  updatedAt DateTime? @updatedAt

  @@index([type, publicationDate])
}

// =============================================
// 2. PAGES & SETTINGS
// =============================================

model PageSection {
  id   Int              @id @default(autoincrement())
  type PageSectionType? @unique

  titleUk   String?
  titleEn   String?
  contentUk String? @db.Text
  contentEn String? @db.Text

  imagePhoto String?

  createdAt DateTime? @default(now())
  updatedAt DateTime? @updatedAt
}

model ExternalLink {
  id      Int              @id @default(autoincrement())
  pageKey ExternalPageKey?

  titleUk String?
  titleEn String?
  url     String?
  order   Int?             @default(0)

  createdAt DateTime? @default(now())
  updatedAt DateTime? @updatedAt

  @@index([pageKey, order])
}

model LyceumStats {
  id Int @id @default(1)

  name      String
  nameEn    String
  addressUk String?
  addressEn String?
  email     String?
  phone     String?
  logoPhoto String?

  quoteUk String? @db.Text
  quoteEn String? @db.Text

  teachingLanguage   String?
  teachingLanguageEn String?
  specialization     String?
  specializationEn   String?

  anthemUrl                 String?
  teachersPhoto             String?
  materialBasePhoto         String?
  materialBaseDescriptionUk String? @db.Text
  materialBaseDescriptionEn String? @db.Text

  socialLinks Json?

  studentsCount     Int? @default(0)
  studentsCountReal Int? @default(0)
  teachersCount     Int? @default(0)
  staffCount        Int? @default(0)
  classesCount      Int? @default(0)
  flexParticipantsCount  Int? @default(0)
  topScorersCount   Int? @default(0)

  createdAt DateTime? @default(now())
  updatedAt DateTime? @updatedAt
}

model FAQ {
  id         Int     @id @default(autoincrement())
  questionUk String?
  questionEn String?
  answerUk   String? @db.Text
  answerEn   String? @db.Text
  order      Int?    @default(0)

  createdAt DateTime? @default(now())
  updatedAt DateTime? @updatedAt

  @@index([order])
}

model Clubs {
  id            Int     @id @default(autoincrement())
  nameUk        String  @db.Text
  nameEn        String  @db.Text
  descriptionUk String? @db.Text
  descriptionEn String? @db.Text

  order         Int?    @default(0)

  createdAt     DateTime? @default(now())
  updatedAt     DateTime? @updatedAt
}

model WorkingArea {
  id     Int    @id @default(autoincrement())
  nameUk String @db.Text
  nameEn String @db.Text

  order  Int?   @default(0)

  createdAt DateTime? @default(now())
  updatedAt DateTime? @updatedAt
}

// =============================================
// 3. PEOPLE & STAFF
// =============================================

model Person {
  id Int @id @default(autoincrement())

  fullNameUk    String
  fullNameEn    String
  positionUk    String?
  positionEn    String?
  descriptionUk String? @db.Text
  descriptionEn String? @db.Text

  photo String?
  email String?
  phone String?

  specializationUk String?
  specializationEn String?

  type  PersonType? @default(TEACHER)
  order Int?        @default(0)

  categoryId Int?
  category   PersonCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  createdAt DateTime? @default(now())
  updatedAt DateTime? @updatedAt

  @@index([type, order])
}

model PersonCategory {
  id      Int      @id @default(autoincrement())
  nameUk  String   @unique
  nameEn  String
  persons Person[]
  order   Int?     @default(0)

  createdAt DateTime? @default(now())
  updatedAt DateTime? @updatedAt
}

// =============================================
// 4. DOCUMENTS & ASSETS
// =============================================

model DocumentReport {
  id       Int               @id @default(autoincrement())
  category DocumentCategory? @default(GENERAL)

  titleUk       String?
  titleEn       String?
  descriptionUk String? @db.Text
  descriptionEn String? @db.Text

  parentId   Int?
  parent     DocumentReport?  @relation("SubReports", fields: [parentId], references: [id], onDelete: Cascade)
  subReports DocumentReport[] @relation("SubReports")

  documents FileAsset[]

  createdAt DateTime? @default(now())
  updatedAt DateTime? @updatedAt

  @@index([category, createdAt])
}

model FileAsset {
  id       Int     @id @default(autoincrement())
  nameUk   String
  nameEn   String
  url      String?
  fileType String?
  fileSize String?

  reportId Int?
  report   DocumentReport? @relation(fields: [reportId], references: [id], onDelete: Cascade)

  createdAt DateTime? @default(now())
  updatedAt DateTime? @updatedAt

  @@index([reportId])
}

// =============================================
// 5. INTERACTIVE & ACADEMICS
// =============================================

model Location {
  id    String  @id @default(cuid())
  floor String?

  nameUk        String
  nameEn        String
  descriptionUk String? @db.Text
  descriptionEn String? @db.Text

  highlightsTextUk String?  @db.Text
  highlightsTextEn String?  @db.Text
  imagePhotos      String[]
  iconName         String?  @db.Text @default("MeetingRoom")

  createdAt DateTime? @default(now())
  updatedAt DateTime? @updatedAt

  @@index([floor])
}

model TestQuestion {
  id         Int     @id @default(autoincrement())
  question   String?
  questionEn String?

  options TestOption[]

  createdAt DateTime? @default(now())
  updatedAt DateTime? @updatedAt
}

model TestOption {
  id       Int     @id @default(autoincrement())
  option   String?
  optionEn String?

  specializationId Int?
  specialization   Specialization? @relation(fields: [specializationId], references: [id], onDelete: Cascade)

  question   TestQuestion? @relation(fields: [questionId], references: [id], onDelete: Cascade)
  questionId Int?

  createdAt DateTime? @default(now())
  updatedAt DateTime? @updatedAt
}

model Specialization {
  id            Int     @id @default(autoincrement())
  nameUk        String
  nameEn        String
  descriptionUk String? @db.Text
  descriptionEn String? @db.Text

  options TestOption[]

  createdAt DateTime? @default(now())
  updatedAt DateTime? @updatedAt
}

model Discipline {
  id          Int                 @id @default(autoincrement())
  name        String
  nameEn      String
  color       String?
  url         String?             @default("#")
  hasSubItems Boolean?            @default(false)
  subItems    DisciplineSubItem[]

  createdAt DateTime? @default(now())
  updatedAt DateTime? @updatedAt
}

model DisciplineSubItem {
  id           Int         @id @default(autoincrement())
  name         String
  link         String?
  disciplineId Int?
  discipline   Discipline? @relation(fields: [disciplineId], references: [id], onDelete: Cascade)

  createdAt DateTime? @default(now())
  updatedAt DateTime? @updatedAt
}

// =============================================
// 6. ADMINISTRATION
// =============================================

model AdminUser {
  id        Int       @id @default(autoincrement())
  username  String    @unique
  password  String?
  role      String?   @default("admin")
  lastLogin DateTime?
  isActive  Boolean?  @default(true)

  createdAt DateTime? @default(now())
  updatedAt DateTime? @updatedAt
}

// =============================================
// ENUMS
// =============================================

enum ContentType {
  NEWS
  RESEARCH_PROJECT
  INNOVATION
  HISTORY
  BUILDING
  FOUNDERS
  FOR_PARENTS
  FOR_STUDENTS
  FOR_TEACHERS
  PATRIOTIC
  CLUBS
  SPORT
  METHODOLOGICAL
  PSYCHOLOGICAL
  ANTI_BULLYING
  QUALIFICATION
  CERTIFICATION
  INTELLECT
  GOVERNMENT
}

enum PersonType {
  TEACHER
  PRINCIPALS
  COMMISSION_MEMBER
  FAMOUS_PERSON
  ALUMNI
  STUDENT_COUNCIL
  PSYCHOLOGIST
}

enum DocumentCategory {
  REGULATORY
  FINANCIAL
  PUBLIC_INFO
  GENERAL
}

enum PageSectionType {
  HOME_HERO
  PARENTS_INFO
  TEACHERS_INFO
  STUDENTS_INFO
  PSYCHOLOGICAL
  CERTIFICATION
  ANTI_BULLYING
  INNOVATIVE
  PROJECT_RESEARCH
  QUALIFICATION
  METHODOLOGICAL
}

enum ExternalPageKey {
  PARENTS
  STUDENTS
  TEACHER_HELP
  PSYCHOLOGICAL
  BULLYING
  CERTIFICATION
  METHODOLOGICAL
  QUALIFICATION
  NEWSPAPER
}