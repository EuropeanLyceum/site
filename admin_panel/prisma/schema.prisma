generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
}

// =============================================
// 1. УНІВЕРСАЛЬНИЙ КОНТЕНТ (Новини, Статті)
// =============================================

model Content {
  id   Int         @id @default(autoincrement())
  type ContentType
  slug String      @unique

  // Заголовки
  titleUk    String
  titleEn    String?
  subtitleUk String? @db.Text
  subtitleEn String? @db.Text

  // Медіа
  mainPhoto     String?
  photoGallery  String[] @default([])
  videoUrl      String?
  imagePosition String   @default("center") // center, left, right, background

  // Логіка
  publicationDate DateTime @default(now())
  isPublished     Boolean  @default(true)
  isFeatured      Boolean  @default(false)
  order           Int      @default(0)

  // Додаткові атрибути (наприклад, автор наукової роботи)
  attributes Json? @default("{}")

  // SEO
  metaTitle       String?
  metaDescription String?

  sections  ContentSection[]
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
}

model ContentSection {
  id        Int     @id @default(autoincrement())
  contentId Int
  content   Content @relation(fields: [contentId], references: [id], onDelete: Cascade)

  visualType String   @default("TEXT") // TEXT, GALLERY, QUOTE, VIDEO
  titleUk    String?
  titleEn    String?
  bodyUk     String?  @db.Text
  bodyEn     String?  @db.Text
  photos     String[] @default([])
  order      Int      @default(0)
}

// =============================================
// 2. СТАТИЧНІ СТОРІНКИ ТА НАЛАШТУВАННЯ
// =============================================

// Використовується для Hero-секцій, вступних текстів на сторінках (Інновації, Історія тощо)
model PageSection {
  id        String   @id // Ключі: "home_hero", "history_intro", "visiting_card", "parents_info"
  titleUk   String?
  titleEn   String?
  contentUk String?  @db.Text
  contentEn String?  @db.Text
  imageUrl  String?  // Банер або фонове зображення

  updatedAt DateTime @updatedAt
}

// Корисні посилання для сайдбарів (Психолог, Сертифікація)
model ExternalLink {
  id      Int     @id @default(autoincrement())
  pageKey String  // До якої сторінки: "psychological", "certification", "anti_bullying"

  titleUk String
  titleEn String?
  url     String
  order   Int     @default(0)
}

model LyceumStats {
  id        Int    @id @default(1)
  name      String // Назва закладу
  nameEn    String
  addressUk String
  addressEn String?
  email     String
  phone     String

  // --- Нові поля ---
  logoUrl       String?  // Посилання на фото логотипа
  quoteUk       String?  @db.Text // Цитата (наприклад, девіз ліцею)
  quoteEn       String?  @db.Text
  teachingLanguages String[] @default(["Українська"]) // Мови викладання
  specializationsList String[] @default([]) // Спеціалізації (для швидкого відображення)
  anthemUrl     String?  // Посилання на файл гімну або відео на YouTube
  // -----------------

  // Соцмережі: { facebook: "...", youtube: "..." }
  socialLinks Json?

  studentsCount    Int @default(0)
  teachersCount    Int @default(0)
  staffCount       Int @default(0)
  classesCount     Int @default(0)
  flexParticipants Int @default(0)
  topScorersCount  Int @default(0)

  updatedAt DateTime @updatedAt
}

model FAQ {
  id          Int      @id @default(autoincrement())
  questionUk  String
  questionEn  String?
  answerUk    String   @db.Text
  answerEn    String?  @db.Text
  category    String?  @default("GENERAL")
  order       Int      @default(0)
  isPublished Boolean  @default(true)
  updatedAt   DateTime @updatedAt
}

// =============================================
// 3. ЛЮДИ (Персонал, Учні, Видатні)
// =============================================

model Person {
  id Int @id @default(autoincrement())

  fullNameUk    String
  fullNameEn    String?
  positionUk    String
  positionEn    String?
  descriptionUk String? @db.Text
  descriptionEn String? @db.Text

  photoUrl         String?
  email            String?
  phone            String?

  // Специфічні поля
  specializationUk String?
  specializationEn String?
  quoteUk          String?
  quoteEn          String?
  nicknameUk       String? // Для учнів/випускників
  nicknameEn       String?

  type  PersonType @default(TEACHER)
  order Int        @default(0)

  categoryId Int?
  category   PersonCategory? @relation(fields: [categoryId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PersonCategory {
  id      Int      @id @default(autoincrement())
  nameUk  String   @unique // Наприклад: "Кафедра математики", "Адміністрація"
  nameEn  String?
  persons Person[]
}

// =============================================
// 4. ДОКУМЕНТИ ТА ЗВІТНІСТЬ
// =============================================

model DocumentReport {
  id       Int              @id @default(autoincrement())
  category DocumentCategory @default(GENERAL)

  titleUk       String
  titleEn       String?
  descriptionUk String? @db.Text
  descriptionEn String? @db.Text
  year          Int?

  // Ієрархія папок
  parentId   Int?
  parent     DocumentReport?  @relation("SubReports", fields: [parentId], references: [id])
  subReports DocumentReport[] @relation("SubReports")

  documents FileAsset[]
  order     Int         @default(0)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
}

model FileAsset {
  id       Int     @id @default(autoincrement())
  nameUk   String
  nameEn   String?
  url      String
  fileType String? // pdf, docx, zip, xlsx
  fileSize String?

  reportId Int?
  report   DocumentReport? @relation(fields: [reportId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
}

// =============================================
// 5. VR-ТУР, ТЕСТИ ТА ПРОФІЛІ
// =============================================

model Location {
  id    String  @id @default(cuid())
  slug  String  @unique
  floor String? // "1", "2", "3", "sport"

  nameUk        String
  nameEn        String
  descriptionUk String   @db.Text
  descriptionEn String   @db.Text

  highlightsUk  String[] // Список особливостей кімнати
  highlightsEn  String[]

  imageUrls String[] // Фото 360 або звичайні
  iconName  String   // Назва іконки для карти

  // Зв'язки для навігації (граф переходів)
  connections Location[] @relation("LocationConnections")
  connectedTo Location[] @relation("LocationConnections")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model TestQuestion {
  id        Int          @id @default(autoincrement())
  question  Json         // { "uk": "Текст питання", "en": "Question text" }
  options   TestOption[]
  createdAt DateTime     @default(now())
}

model TestOption {
  id         Int          @id @default(autoincrement())
  questionId Int
  question   TestQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  text       Json         // { "uk": "Варіант А", "en": "Option A" }
  type       String       // "math", "philology", "art" - до якого профілю веде
}

model Specialization {
  id                String   @id // math, philology, it
  emoji             String
  nameUk            String
  nameEn            String
  descriptionUk     String   @db.Text
  descriptionEn     String   @db.Text

  subjectsUk        String[] // Профільні предмети
  subjectsEn        String[]
  characteristicsUk String[] // "Вміння аналізувати", "Креативність"
  characteristicsEn String[]

  createdAt         DateTime @default(now())
}

// =============================================
// 6. АДМІНІСТРУВАННЯ
// =============================================

model AdminUser {
  id        Int       @id @default(autoincrement())
  username  String    @unique
  password  String    // Hashed
  role      String    @default("admin")
  lastLogin DateTime?
  createdAt DateTime  @default(now())
  isActive  Boolean   @default(true)
}

// =============================================
// ENUMS
// =============================================

enum ContentType {
  NEWS
  EVENT
  PROJECT
  RESEARCH
  INNOVATION
  HISTORY
  FOR_PARENTS
  FOR_STUDENTS
  FOR_TEACHERS
  VISITING_CARD
  PATRIOTIC
  CLUBS
  SPORT
  METHODOLOGICAL
  PSYCHOLOGICAL
  ANTI_BULLYING
  QUALIFICATION
  CERTIFICATION
}

enum PersonType {
  TEACHER
  ADMINISTRATION
  COMMISSION_MEMBER
  FAMOUS_PERSON
  ALUMNI
  STUDENT_COUNCIL
  PSYCHOLOGIST
}

enum DocumentCategory {
  REGULATORY
  FINANCIAL
  PUBLIC_INFO
  GENERAL
}